# =============================================================================
# Freelancermap Control
# Dashboard (Vercel) + 3 Chrome extension workers + Supabase
# Docs: docs/DEPLOY_DASHBOARD.md
# =============================================================================

# Supabase — run supabase/control_plane.sql (+ assessment_spec.sql if control_plane was applied earlier)
# Never put the service role key in the Chrome extension
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Control API tokens (same values in Vercel → Environment Variables)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=
BOT_1_TOKEN=
BOT_2_TOKEN=
BOT_3_TOKEN=

GITHUB_TOKEN=
GITHUB_REPO=creativesolution999/full-stack-assignment
# Optional overrides (default = split of GITHUB_REPO)
GITHUB_ORG=
ASSESSMENT_REPO=

# Telegram handoff alerts (numeric chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter — assessment chat after candidates reply to outreach DMs
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local only: PYTHONPATH=. python3 -m src.main control-serve (unused on Vercel)
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8090
