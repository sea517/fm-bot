# freelancermap login
FREELANCERMAP_EMAIL=
FREELANCERMAP_PASSWORD=
FREELANCERMAP_BASE_URL=https://www.freelancermap.de
FREELANCERMAP_MESSAGES_URL=

# Oliver inbox — Namecheap Private Email
# IMAP auth failed? Use App Password: privateemail.com → Settings → Security → Manage app passwords
# Primary mailbox login (oliver@ / sabrina@ are aliases — IMAP must use the real mailbox)
INBOX_EMAIL=info@kontrora.com
INBOX_FROM_EMAIL=oliver@kontrora.com
INBOX_FROM_NAME=Oliver
INBOX_PASSWORD=
INBOX_IMAP_HOST=mail.privateemail.com
# Optional HTTPS sending (port 443) for networks that block SMTP.
# EMAIL_API_PROVIDER=resend|sendgrid|brevo
EMAIL_API_PROVIDER=resend
EMAIL_API_KEY=
INBOX_SMTP_HOST=mail.privateemail.com
INBOX_SMTP_PORT=465

# GitHub — PAT with repo scope (NOT account password)
GITHUB_TOKEN=
GITHUB_REPO=Kontrora-Group/full-stack-assignment

# Slack — private channel + Slack Connect external invite per candidate
SLACK_BOT_TOKEN=          # xoxb-... scopes: groups:write, conversations.connect:write, chat:write, groups:history
SLACK_USER_TOKEN=         # xoxp-... Oliver's USER token (user scope chat:write) — posts as Oliver, not the app
SLACK_TEAM_ID=            # e.g. T0BQPFVS6AX
SLACK_TEAM_MEMBER_IDS=    # comma-separated recruiter user IDs (U...) including Oliver

# AI replies — leave AI_PROVIDER empty to auto-pick:
#   OPENROUTER_API_KEY set -> openrouter, otherwise -> gemini
# Force one with AI_PROVIDER=openrouter or AI_PROVIDER=gemini
AI_PROVIDER=

# OpenRouter — key from https://openrouter.ai/keys (starts with sk-or-v1-)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini (direct, only used when AI_PROVIDER=gemini or no OpenRouter key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Job posting (used for AI replies + XML feed)
PROJECT_TITLE=Staff Engineer (Contract) — Revenue & Billing Systems on a Live PSA Platform
PROJECT_DESCRIPTION_FILE=data/descriptions/staff-engineer-revenue-billing.txt
PROJECT_EXTERNAL_ID=kontrora-staff-revenue-001
PROJECT_DURATION_MONTHS=1

POLL_INTERVAL_SECONDS=10800
# Slack Mon–Fri 10:00–17:00 America/New_York while assessments are active
SLACK_POLL_INTERVAL_SECONDS=45
# Outside that window — Slack only with the slower full cycle (default 3h)
SLACK_OFF_HOURS_POLL_SECONDS=10800
DATABASE_URL=sqlite:///data/bot.db

# Supabase — save freelancers already contacted on freelancermap
# 1) Run supabase/contacted_freelancers.sql in the Supabase SQL Editor
# 2) Project Settings → API → Project URL + service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Outbound DMs — https://www.freelancermap.com/freelancer
OUTREACH_SEARCH_URL=https://www.freelancermap.com/freelancer
# Must match a project name in the Contact form "Select project" dropdown
OUTREACH_PROJECT_NAME=

FEED_HOST=0.0.0.0
FEED_PORT=8080
FEED_PUBLIC_URL=http://your-server:8080/feed.xml

# Control plane (dashboard + extension workers) — deploy on Vercel (see docs/DEPLOY_DASHBOARD.md)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Run SQL: supabase/control_plane.sql in Supabase SQL Editor
# Local: PYTHONPATH=. python3 -m src.main control-serve
# Vercel env: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, DASHBOARD_API_TOKEN, BOT_1/2/3_TOKEN
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8090
DASHBOARD_API_TOKEN=
BOT_1_TOKEN=
BOT_2_TOKEN=
BOT_3_TOKEN=
