# =============================================================================
# Freelancermap Control
# Dashboard (Vercel) + 3 Chrome extension workers + Supabase
# Docs: docs/DEPLOY_DASHBOARD.md
# =============================================================================

# Supabase — run supabase/control_plane.sql (+ contacted_freelancers.sql if needed)
# Never put the service role key in the Chrome extension
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Control API tokens (same values in Vercel → Environment Variables)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=
BOT_1_TOKEN=
BOT_2_TOKEN=
BOT_3_TOKEN=

# Local only: PYTHONPATH=. python3 -m src.main control-serve (unused on Vercel)
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8090
